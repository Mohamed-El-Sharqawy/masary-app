{
  "expo": {
    "name": "مصاري",
    "slug": "masary",
    "version": "1.0.0",
    "scheme": "masary",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.masary.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.masary.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFF1F3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "تسجيل المصروفات بالصوت"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF1F3"
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
